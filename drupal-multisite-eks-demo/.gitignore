!web/sites/site_a/
!web/sites/site_b/
web/sites/default/*
web/sites/site_a/*
web/sites/site_b/*
!web/sites/default/settings.php
!web/sites/site_a/settings.php
!web/sites/site_b/settings.php
local-files/
*.sql
*.sql.gz
.DS_Store
