{
  "name": "portfolio/drupal-multisite-eks-demo",
  "description": "Drupal multisite reference implementation independent of Acquia BLT",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [{"type": "composer", "url": "https://packages.drupal.org/8"}],
  "require": {
    "php": "^8.3",
    "composer/installers": "^2.3",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-project-message": "^11",
    "drupal/core-recommended": "^11",
    "drush/drush": "^13"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "php-http/discovery": true,
      "symfony/runtime": false,
      "tbachert/spi": false
    },
    "sort-packages": true
  },
  "extra": {
    "drupal-scaffold": {"locations": {"web-root": "web/"}},
    "installer-paths": {
      "web/core": ["type:drupal-core"],
      "web/libraries/{$name}": ["type:drupal-library"],
      "web/modules/contrib/{$name}": ["type:drupal-module"],
      "web/profiles/contrib/{$name}": ["type:drupal-profile"],
      "web/themes/contrib/{$name}": ["type:drupal-theme"],
      "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
    }
  }
}
